source "https://rubygems.org"

# Modern stable Jekyll
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
end

# Required for Windows
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# DO NOT USE wdm (not compatible with Ruby 3.4)
gem "logger"
